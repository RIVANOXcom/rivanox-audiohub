#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Operator-only Pi4 local music. No autoplay; only the existing PLAY wizard
# starts an owned local player in the existing audiohub.music input.
set -eu

usage() {
  printf '%s\n' \
    'AudioHub local music (unverified Pi4 operator alpha)' \
    'Usage: audiohub-music [ABSOLUTE_PRIVATE_WAV_FOLDER] [--minutes 1..30] [--level quiet|soft|normal] [--channel both|left|right] [--show-titles]' \
    '       audiohub-music [ABSOLUTE_PRIVATE_WAV_FOLDER] --list [--show-titles]' \
    '       audiohub-music [ABSOLUTE_PRIVATE_WAV_FOLDER] --check' \
    '       audiohub-music --speaker-test [left|right|both]' \
    '       audiohub-music --speaker-guide [left|right|both]' \
    '       audiohub-music --speaker-check' \
    'Default: /home/audiohub/PrivateMusic, 15 minutes, normal stream level (0.20).' \
    'quiet=0.05, soft=0.10, normal=0.20; levels are stream gains, not calibrated speaker loudness.' \
    '--channel left/right silences only the opposite stereo WAV channel; mono needs both.' \
    '--list only shows valid WAV track numbers and format; it NEVER plays sound.' \
    '--check independently checks WAVs, private music input and player tool, without sound.' \
    '--speaker-check checks built-in FIRST SOUND without a WAV library and never plays sound.' \
    '--speaker-test creates a brief original 2.1s LEFT/RIGHT/BOTH signal in RAM. No WAV required.' \
    'Optional left, right or both replays that channel 3 times with short silence gaps.' \
    '--speaker-guide checks all three sides, or ONLY one targeted left/right/both side.' \
    'It asks for separate PLAY per side and LOCAL physical observations.' \
    'If unsure/wrong, RETRY same side once with fresh PLAY, or STOP; no auto-next.' \
    'Requires separate PLAY at a local terminal; very low signal and quiet stream only.' \
    '--show-titles explicitly reveals sanitized private titles on this terminal.' \
    'The playback wizard shows an anonymous list; select numbers, ALL or SHUFFLE.' \
    'PLAY is required separately to start sound; CHANGE revises the queue.' \
    'During playback: u=pause/resume, m=repeat, n=next, q=stop, Ctrl+C=stop.' \
    'No network, settings, privileged operation or background service is started.'
}

if [ "$#" -eq 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
  usage
  exit 0
fi

# WAV-free first-sound prerequisites only: never touch music files
# or launch an audio player. An isolated option prevents --check ambiguity.
if [ "$#" -ge 1 ] && [ "$1" = "--speaker-check" ]; then
  if [ "$#" -ne 1 ]; then
    printf '%s\n' 'Speaker check accepts no extra arguments.' >&2
    exit 2
  fi
  if [ "$(/usr/bin/id -u)" -eq 0 ]; then
    printf '%s\n' 'Run as the existing unprivileged Pi operator, not root.' >&2
    exit 2
  fi
  PYTHONPATH=/opt/audiohub/src
  export PYTHONPATH
  exec /usr/bin/python3 -m audiohub.local_music --speaker-check
fi

# Exclusive no-WAV operator guide; optionally recheck exactly ONE target.
# There is no default audio, auto-play, combined flag or folder support.
if [ "$#" -ge 1 ] && [ "$1" = "--speaker-guide" ]; then
  if [ "$#" -gt 2 ]; then
    printf '%s\n' 'Speaker guide accepts only optional left, right or both.' >&2
    exit 2
  fi
  if [ "$#" -eq 2 ]; then
    case "$2" in
      left|right|both) ;;
      *) printf '%s\n' 'Only left, right or both targeted rechecks are supported.' >&2; exit 2 ;;
    esac
  fi
  if [ "$(/usr/bin/id -u)" -eq 0 ]; then
    printf '%s\n' 'Run as the existing unprivileged Pi operator, not root.' >&2
    exit 2
  fi
  PYTHONPATH=/opt/audiohub/src
  export PYTHONPATH
  if [ "$#" -eq 2 ]; then
    exec /usr/bin/python3 -m audiohub.local_music --speaker-guide "$2"
  fi
  exec /usr/bin/python3 -m audiohub.local_music --speaker-guide
fi

# Separate exclusive sound test: there is never implicit playback, no WAV,
# volume elevation, output routing, network service or privileged override.
if [ "$#" -ge 1 ] && [ "$1" = "--speaker-test" ]; then
  if [ "$#" -gt 2 ]; then
    printf '%s\n' 'Speaker test accepts only optional left, right or both.' >&2
    exit 2
  fi
  if [ "$#" -eq 2 ]; then
    case "$2" in
      left|right|both) ;;
      *) printf '%s\n' 'Only left, right or both speaker test is supported.' >&2; exit 2 ;;
    esac
  fi
  if [ "$(/usr/bin/id -u)" -eq 0 ]; then
    printf '%s\n' 'Run as the existing unprivileged Pi operator, not root.' >&2
    exit 2
  fi
  PYTHONPATH=/opt/audiohub/src
  export PYTHONPATH
  if [ "$#" -eq 2 ]; then
    exec /usr/bin/python3 -m audiohub.local_music --speaker-test "$2"
  fi
  exec /usr/bin/python3 -m audiohub.local_music --speaker-test
fi

folder=/home/audiohub/PrivateMusic
folder_seen=0
minutes=15
minutes_seen=0
level=normal
level_seen=0
channel=both
channel_seen=0
list_only=0
check_only=0
titles=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --minutes)
      if [ "$minutes_seen" -ne 0 ] || [ "$#" -lt 2 ]; then
        printf '%s\n' 'Provide one explicit bounded --minutes value.' >&2; exit 2
      fi
      # Bounded digit patterns avoid shell integer overflow and extra flags.
      case "$2" in
        [1-9]|[12][0-9]|30) minutes=$2 ;;
        *) printf '%s\n' 'Minutes must be a whole number from 1 through 30.' >&2; exit 2 ;;
      esac
      minutes_seen=1
      shift 2
      ;;
    --level)
      if [ "$level_seen" -ne 0 ] || [ "$#" -lt 2 ]; then
        printf '%s\n' 'Provide one local --level choice.' >&2; exit 2
      fi
      case "$2" in
        quiet|soft|normal) level=$2 ;;
        *) printf '%s\n' 'Only quiet, soft or normal stream gain is supported.' >&2; exit 2 ;;
      esac
      level_seen=1
      shift 2
      ;;
    --channel)
      if [ "$channel_seen" -ne 0 ] || [ "$#" -lt 2 ]; then
        printf '%s\n' 'Choose one local stereo channel mode.' >&2; exit 2
      fi
      case "$2" in
        both|left|right) channel=$2 ;;
        *) printf '%s\n' 'Only both, left or right stereo channels are supported.' >&2; exit 2 ;;
      esac
      channel_seen=1
      shift 2
      ;;
    --list)
      if [ "$list_only" -ne 0 ]; then
        printf '%s\n' 'Duplicate --list is not supported.' >&2; exit 2
      fi
      list_only=1
      shift
      ;;
    --check)
      if [ "$check_only" -ne 0 ]; then
        printf '%s\n' 'Duplicate --check is not supported.' >&2; exit 2
      fi
      check_only=1
      shift
      ;;
    --show-titles)
      if [ "$titles" -ne 0 ]; then
        printf '%s\n' 'Duplicate --show-titles is not supported.' >&2; exit 2
      fi
      titles=1
      shift
      ;;
    /*)
      if [ "$folder_seen" -ne 0 ]; then
        printf '%s\n' 'Choose only one absolute WAV folder.' >&2; exit 2
      fi
      folder=$1
      folder_seen=1
      shift
      ;;
    --*|-*|*)
      printf '%s\n' 'Invalid option or relative folder; use --help.' >&2
      exit 2
      ;;
  esac
done

if [ "$(/usr/bin/id -u)" -eq 0 ]; then
  printf '%s\n' 'Run as the existing unprivileged Pi operator, not root.' >&2
  exit 2
fi

PYTHONPATH=/opt/audiohub/src
export PYTHONPATH
if [ "$check_only" -eq 1 ]; then
  if [ "$list_only" -ne 0 ] || [ "$titles" -ne 0 ] || \
     [ "$minutes_seen" -ne 0 ] || [ "$level_seen" -ne 0 ] || \
     [ "$channel_seen" -ne 0 ]; then
    printf '%s\n' 'Use --check with only one optional absolute private WAV folder.' >&2
    exit 2
  fi
  # Readiness is not a speaker test. Never starts playback or changes routes.
  exec /usr/bin/python3 -m audiohub.local_music --check --library "$folder"
fi
if [ "$list_only" -eq 1 ]; then
  if [ "$channel_seen" -ne 0 ]; then
    printf '%s\n' '--channel applies only to an explicitly confirmed PLAY session.' >&2
    exit 2
  fi
  # Anonymous read-only listing without a TTY or any PipeWire process.
  if [ "$titles" -eq 1 ]; then
    exec /usr/bin/python3 -m audiohub.local_music --library "$folder" --show-titles
  fi
  exec /usr/bin/python3 -m audiohub.local_music --library "$folder"
fi

# This script NEVER starts playback. PLAY is a separate explicit TTY input
# within the bounded existing music_library.guided_session confirmation gate.
if [ "$titles" -eq 1 ]; then
  exec /usr/bin/python3 -m audiohub.local_music \
    --guided --library "$folder" --minutes "$minutes" --level "$level" --channel "$channel" --show-titles
fi
exec /usr/bin/python3 -m audiohub.local_music \
  --guided --library "$folder" --minutes "$minutes" --level "$level" --channel "$channel"
