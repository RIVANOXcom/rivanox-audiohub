#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Operator-only offline WAV backup/restore; never starts audio or a service.
set -eu
if [ "$#" -eq 1 ] && { [ "$1" = "--help" ] || [ "$1" = "-h" ]; }; then
  PYTHONPATH=/opt/audiohub/src
  export PYTHONPATH
  exec /usr/bin/python3 -m audiohub.music_transfer --help
fi
if [ "$#" -ne 2 ]; then
  printf '%s\n' 'Use: audiohub-music-transfer backup|restore /absolute/private/external-folder' >&2
  exit 2
fi
case "$1" in
  backup|restore) ;;
  *) printf '%s\n' 'Choose backup or restore.' >&2; exit 2 ;;
esac
case "$2" in
  /*) ;;
  *) printf '%s\n' 'External directory must be absolute and private.' >&2; exit 2 ;;
esac
if [ "$(/usr/bin/id -u)" -eq 0 ]; then
  printf '%s\n' 'Only an unprivileged local operator may transfer WAVs.' >&2
  exit 2
fi
PYTHONPATH=/opt/audiohub/src
export PYTHONPATH
exec /usr/bin/python3 -m audiohub.music_transfer "$1" "$2"
