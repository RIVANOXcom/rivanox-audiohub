#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# Operator-only offline WAV backup/restore/verification, no services or mounts.
set -eu
if [ "$#" -eq 1 ] && { [ "$1" = "--help" ] || [ "$1" = "-h" ]; }; then
  PYTHONPATH=/opt/audiohub/src
  export PYTHONPATH
  exec /usr/bin/python3 -m audiohub.music_transfer --help
fi
if [ "$#" -ne 2 ] && [ "$#" -ne 3 ]; then
  printf '%s\n' 'Use: audiohub-music-transfer backup|restore|verify-backup|verify-restore ABSOLUTE_FOLDER [--resume]' >&2
  exit 2
fi
case "$1" in
  backup|restore) ;;
  verify-backup|verify-restore)
    if [ "$#" -ne 2 ]; then
      printf '%s\n' 'Verification is read-only and has no resume flag.' >&2
      exit 2
    fi
    ;;
  *) printf '%s\n' 'Choose backup, restore, verify-backup or verify-restore.' >&2; exit 2 ;;
esac
if [ "$#" -eq 3 ] && [ "$3" != "--resume" ]; then
  printf '%s\n' 'Only exact --resume is supported on backup and restore.' >&2
  exit 2
fi
case "$2" in
  /*) ;;
  *) printf '%s\n' 'External directory must be absolute and private.' >&2; exit 2 ;;
esac
if [ "$(/usr/bin/id -u)" -eq 0 ]; then
  printf '%s\n' 'Only an unprivileged local operator may transfer WAVs.' >&2
  exit 2
fi
PYTHONPATH=/opt/audiohub/src
export PYTHONPATH
exec /usr/bin/python3 -m audiohub.music_transfer "$@"
